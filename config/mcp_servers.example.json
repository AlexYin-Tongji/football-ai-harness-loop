{
  "servers": [
    {
      "id": "football-data",
      "transport": "streamable-http",
      "url_env": "FOOTBALL_DATA_MCP_URL",
      "token_env": "FOOTBALL_DATA_MCP_TOKEN",
      "read_only": true,
      "allowed_tool_prefixes": ["fixtures.", "matches.", "teams.", "lineups."]
    },
    {
      "id": "news-evidence",
      "transport": "streamable-http",
      "url_env": "NEWS_EVIDENCE_MCP_URL",
      "token_env": "NEWS_EVIDENCE_MCP_TOKEN",
      "read_only": true,
      "allowed_tool_prefixes": ["news.search_", "evidence.fetch_", "evidence.resolve_"]
    },
    {
      "id": "source-registry",
      "transport": "stdio",
      "command": "python -m services.source_registry_mcp",
      "read_only": true,
      "allowed_tool_prefixes": ["sources."]
    },
    {
      "id": "report-memory",
      "transport": "stdio",
      "command": "python -m services.report_memory_mcp",
      "read_only": false,
      "allowed_tool_prefixes": ["memory.get_", "memory.put_", "memory.delete_"]
    }
  ]
}

