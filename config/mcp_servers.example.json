{
  "servers": {
    "source-registry": {
      "command": "python",
      "args": ["-m", "services.mcp_servers.source_registry"],
      "transport": "stdio",
      "read_only": true
    },
    "news-discovery": {
      "command": "python",
      "args": ["-m", "services.mcp_servers.news_discovery"],
      "transport": "stdio",
      "read_only": true
    },
    "rss-news": {
      "command": "python",
      "args": ["-m", "services.mcp_servers.rss_news"],
      "transport": "stdio",
      "read_only": true
    },
    "football-data": {
      "command": "python",
      "args": ["-m", "services.mcp_servers.football_data"],
      "transport": "stdio",
      "read_only": true,
      "required_env": ["FOOTBALL_DATA_API_KEY"]
    },
    "sportmonks": {
      "command": "python",
      "args": ["-m", "services.mcp_servers.sportmonks"],
      "transport": "stdio",
      "read_only": true,
      "required_env": ["SPORTMONKS_API_TOKEN"]
    },
    "media-assets": {
      "command": "python",
      "args": ["-m", "services.mcp_servers.media_assets"],
      "transport": "stdio",
      "read_only": true,
      "optional_env": ["YOUTUBE_API_KEY", "YOUTUBE_OFFICIAL_CHANNEL_IDS"]
    }
  }
}
