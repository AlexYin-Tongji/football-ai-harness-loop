{
  "servers": {
    "source-registry": {
      "command": "python",
      "args": ["-m", "services.mcp_servers.source_registry"],
      "transport": "stdio",
      "read_only": true
    },
    "news-discovery": {
      "command": "python",
      "args": ["-m", "services.mcp_servers.news_discovery"],
      "transport": "stdio",
      "read_only": true
    },
    "football-data": {
      "command": "python",
      "args": ["-m", "services.mcp_servers.football_data"],
      "transport": "stdio",
      "read_only": true,
      "required_env": ["FOOTBALL_DATA_API_KEY"]
    }
  }
}
